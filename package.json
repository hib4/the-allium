{
  "name": "the-allium",
  "version": "1.1.0-rc.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "audio": "node scripts/audio-service.mjs",
    "test:audio": "node scripts/audio-tests.mjs",
    "test:integration": "npm run build && playwright test --config playwright.audio.config.ts",
    "release:mac": "npm run build && .venv/bin/python release/build.py",
    "test:soak": "node scripts/soak.mjs",
    "visuals:record": "node scripts/living-comparison.mjs record",
    "visuals:compare": "node scripts/living-comparison.mjs compare",
    "visuals:fixture": "node scripts/living-comparison.mjs fixture"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.2.5",
    "pixi.js": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.52.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
